# ==============================================================================
# POSTGRESQL — BANCO DE DADOS PRINCIPAL
# ==============================================================================
# String de conexão completa do PostgreSQL (Render, Supabase, Railway, local...)
# Exemplo Render: postgresql://usuario:senha@host.render.com:5432/dbname
DATABASE_URL=postgresql://usuario:senha@host:5432/dbname

# ==============================================================================
# AUTENTICAÇÃO ADMIN (JWT + bcrypt)
# ==============================================================================
# Chave secreta longa e aleatória para assinar os tokens JWT do painel admin
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=sua_chave_secreta_muito_longa_aqui

# E-mail e hash bcrypt da senha do administrador
# Para gerar o hash: node scripts/hash-senha.js SuaSenhaSegura123
ADMIN_EMAIL=lnGSN@lnsports.com.br
ADMIN_PASSWORD_HASH=$2b$12$...hash_bcrypt_aqui...
# Opcional em dev: aponte o frontend para o backend Express/Render.
# Sem isso, o Vite usa proxy /api/* -> http://localhost:3001 (veja vite.config.js).
# VITE_API_URL=http://localhost:3001
PORT=3001

# ==============================================================================
# CONFIGURAÇÕES DA LOJA (opcionais — podem ser editadas pelo painel admin)
# ==============================================================================
# Formato internacional: 55 + DDD + Número (apenas dígitos)
VITE_STORE_WHATSAPP_NUMBER=5549998046866
VITE_STORE_NAME=LN SPORTS

# ==============================================================================
# FIREBASE (MANTIDO PARA COMPATIBILIDADE — NÃO É MAIS NECESSÁRIO)
# Deixe em branco ou remova após confirmar que o PostgreSQL funciona.
# ==============================================================================
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
