# ==============================================================================
# CONFIGURAÇÕES DO FIREBASE (FRONTEND LN-SPORTS)
# ==============================================================================
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus apps)
VITE_FIREBASE_API_KEY=sua_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu_projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu_projeto_id
VITE_FIREBASE_STORAGE_BUCKET=seu_projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=seu_sender_id
VITE_FIREBASE_APP_ID=seu_app_id

# ==============================================================================
# ATENDIMENTO WHATSAPP CENTRALIZADO
# ==============================================================================
# Formato internacional: 55 + DDD + Número (apenas dígitos)
VITE_STORE_WHATSAPP_NUMBER=5511999999999
VITE_STORE_NAME=LN SPORTS
